{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "8727954485209371346"
    }
  },
  "parameters": {
    "customerSlug": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "appServicePlanSku": {
      "type": "string"
    },
    "integrationSubnetId": {
      "type": "string"
    },
    "appInsightsInstrumentationKey": {
      "type": "string"
    },
    "appInsightsConnectionString": {
      "type": "string"
    },
    "openAiInstanceName": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI resource name (NOT the endpoint URL) — azure-ai.ts requireEnv(\"AZURE_OPENAI_API_INSTANCE_NAME\")."
      }
    },
    "openAiApiVersion": {
      "type": "string",
      "metadata": {
        "description": "Azure OpenAI REST API version — azure-ai.ts AZURE_OPENAI_API_VERSION."
      }
    },
    "chatDeploymentName": {
      "type": "string",
      "metadata": {
        "description": "Chat model deployment name — azure-ai.ts AZURE_OPENAI_CHAT_DEPLOYMENT."
      }
    },
    "embeddingDeploymentName": {
      "type": "string",
      "metadata": {
        "description": "Embedding model deployment name — azure-ai.ts AZURE_OPENAI_EMBEDDING_DEPLOYMENT."
      }
    },
    "embeddingDimensions": {
      "type": "int",
      "metadata": {
        "description": "Embedding vector width — azure-ai.ts AZURE_OPENAI_EMBEDDING_DIMENSIONS."
      }
    },
    "searchName": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Search resource name (NOT the endpoint URL) — ai-search.ts AZURE_SEARCH_NAME."
      }
    },
    "searchIndexName": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Search index name — ai-search.ts / azure-ai-search.ts AZURE_SEARCH_INDEX_NAME."
      }
    },
    "cosmosDbUri": {
      "type": "string",
      "metadata": {
        "description": "Cosmos DB endpoint URI — cosmos.ts AZURE_COSMOSDB_URI."
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault name (NOT the endpoint URL) — key-vault.ts AZURE_KEY_VAULT_NAME."
      }
    },
    "keyVaultUri": {
      "type": "string",
      "metadata": {
        "description": "Key Vault URI (e.g. https://kv-azurechat-{slug}.vault.azure.net/) — SR-001: used to build Key Vault reference app-setting values below. Never a secret itself."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name — azure-storage.ts AZURE_STORAGE_ACCOUNT_NAME."
      }
    },
    "documentIntelligenceEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Document Intelligence endpoint URL — document-intelligence.ts AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT."
      }
    },
    "tenantSlug": {
      "type": "string",
      "metadata": {
        "description": "Customer slug echoed back as TENANT_SLUG — src/features/theme/tenant-resolver.ts fallback when the Host header is not a recognized {slug}-sales360 subdomain."
      }
    },
    "speechRegion": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Speech region — proposed contract: AZURE_SPEECH_REGION, consumed by the speech token-issuing API route."
      }
    },
    "speechResourceId": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Speech account full ARM resource ID — proposed contract: AZURE_SPEECH_RESOURCE_ID (never a key)."
      }
    },
    "speechEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Azure AI Speech account endpoint URL — proposed contract: AZURE_SPEECH_ENDPOINT."
      }
    },
    "restrictIngressToCloudflare": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "H-2 — restrict App Service ingress to Cloudflare IP ranges only (default-deny otherwise). Must be false only for an explicitly documented exception (see val1 in known-limitations.md); true for every production customer."
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "cloudflareIpSecurityRestrictions",
        "count": "[length(concat(variables('cloudflareIpv4Ranges'), variables('cloudflareIpv6Ranges')))]",
        "input": {
          "ipAddress": "[concat(variables('cloudflareIpv4Ranges'), variables('cloudflareIpv6Ranges'))[copyIndex('cloudflareIpSecurityRestrictions')]]",
          "action": "Allow",
          "priority": "[add(100, copyIndex('cloudflareIpSecurityRestrictions'))]",
          "name": "[format('cloudflare-{0}', copyIndex('cloudflareIpSecurityRestrictions'))]",
          "description": "Cloudflare edge IP range — pinned 2026-08-11"
        }
      }
    ],
    "cloudflareIpv4Ranges": [
      "173.245.48.0/20",
      "103.21.244.0/22",
      "103.22.200.0/22",
      "103.31.4.0/22",
      "141.101.64.0/18",
      "108.162.192.0/18",
      "190.93.240.0/20",
      "188.114.96.0/20",
      "197.234.240.0/22",
      "198.41.128.0/17",
      "162.158.0.0/15",
      "104.16.0.0/13",
      "104.24.0.0/14",
      "172.64.0.0/13",
      "131.0.72.0/22"
    ],
    "cloudflareIpv6Ranges": [
      "2400:cb00::/32",
      "2606:4700::/32",
      "2803:f800::/32",
      "2405:b500::/32",
      "2405:8100::/32",
      "2a06:98c0::/29",
      "2c0f:f248::/32"
    ],
    "planName": "[format('plan-azurechat-{0}', parameters('customerSlug'))]",
    "appName": "[format('app-azurechat-{0}', parameters('customerSlug'))]",
    "azureAdClientSecretKeyVaultRef": "[format('@Microsoft.KeyVault(SecretUri={0}secrets/azure-ad-client-secret/)', parameters('keyVaultUri'))]",
    "nextAuthSecretKeyVaultRef": "[format('@Microsoft.KeyVault(SecretUri={0}secrets/nextauth-secret/)', parameters('keyVaultUri'))]",
    "nextAuthUrlPlaceholder": "[format('https://{0}.azurewebsites.net', variables('appName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('appServicePlanSku')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "clientAffinityEnabled": false,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "vnetRouteAllEnabled": true,
          "ipSecurityRestrictions": "[if(parameters('restrictIngressToCloudflare'), variables('cloudflareIpSecurityRestrictions'), createArray())]",
          "ipSecurityRestrictionsDefaultAction": "[if(parameters('restrictIngressToCloudflare'), 'Deny', 'Allow')]",
          "scmIpSecurityRestrictionsUseMain": false,
          "appSettings": [
            {
              "name": "AZURE_OPENAI_API_INSTANCE_NAME",
              "value": "[parameters('openAiInstanceName')]"
            },
            {
              "name": "AZURE_OPENAI_API_VERSION",
              "value": "[parameters('openAiApiVersion')]"
            },
            {
              "name": "AZURE_OPENAI_CHAT_DEPLOYMENT",
              "value": "[parameters('chatDeploymentName')]"
            },
            {
              "name": "AZURE_OPENAI_EMBEDDING_DEPLOYMENT",
              "value": "[parameters('embeddingDeploymentName')]"
            },
            {
              "name": "AZURE_OPENAI_EMBEDDING_DIMENSIONS",
              "value": "[string(parameters('embeddingDimensions'))]"
            },
            {
              "name": "AZURE_SEARCH_NAME",
              "value": "[parameters('searchName')]"
            },
            {
              "name": "AZURE_SEARCH_INDEX_NAME",
              "value": "[parameters('searchIndexName')]"
            },
            {
              "name": "AZURE_COSMOSDB_URI",
              "value": "[parameters('cosmosDbUri')]"
            },
            {
              "name": "AZURE_KEY_VAULT_NAME",
              "value": "[parameters('keyVaultName')]"
            },
            {
              "name": "AZURE_AD_CLIENT_SECRET",
              "value": "[variables('azureAdClientSecretKeyVaultRef')]"
            },
            {
              "name": "NEXTAUTH_SECRET",
              "value": "[variables('nextAuthSecretKeyVaultRef')]"
            },
            {
              "name": "AZURE_STORAGE_ACCOUNT_NAME",
              "value": "[parameters('storageAccountName')]"
            },
            {
              "name": "AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT",
              "value": "[parameters('documentIntelligenceEndpoint')]"
            },
            {
              "name": "AZURE_SPEECH_REGION",
              "value": "[parameters('speechRegion')]"
            },
            {
              "name": "AZURE_SPEECH_RESOURCE_ID",
              "value": "[parameters('speechResourceId')]"
            },
            {
              "name": "AZURE_SPEECH_ENDPOINT",
              "value": "[parameters('speechEndpoint')]"
            },
            {
              "name": "USE_MANAGED_IDENTITIES",
              "value": "true"
            },
            {
              "name": "TENANT_SLUG",
              "value": "[parameters('tenantSlug')]"
            },
            {
              "name": "NEXTAUTH_URL",
              "value": "[variables('nextAuthUrlPlaceholder')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[parameters('appInsightsInstrumentationKey')]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[parameters('appInsightsConnectionString')]"
            }
          ]
        },
        "virtualNetworkSubnetId": "[parameters('integrationSubnetId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ]
    }
  ],
  "outputs": {
    "appServiceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/sites', variables('appName'))]"
    },
    "appServicePrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-01-01', 'full').identity.principalId]"
    },
    "appServiceHostname": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-01-01').defaultHostName]"
    },
    "appServicePlanId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
    }
  }
}