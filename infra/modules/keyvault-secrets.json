{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "4478794748990761988"
    }
  },
  "parameters": {
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the customer Key Vault (kv-azurechat-{slug})."
      }
    },
    "azureAdClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "Entra confidential-client secret consumed by NextAuth via a Key Vault reference. Never logged."
      }
    },
    "nextAuthSecret": {
      "type": "securestring",
      "metadata": {
        "description": "NextAuth JWT/session signing secret. Never logged."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'azure-ad-client-secret')]",
      "properties": {
        "value": "[parameters('azureAdClientSecret')]",
        "contentType": "Entra confidential-client secret for salescoach360-{slug}-auth",
        "attributes": {
          "enabled": true
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', parameters('keyVaultName'), 'nextauth-secret')]",
      "properties": {
        "value": "[parameters('nextAuthSecret')]",
        "contentType": "NextAuth session/JWT signing secret",
        "attributes": {
          "enabled": true
        }
      }
    }
  ]
}