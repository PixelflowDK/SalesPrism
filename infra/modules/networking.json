{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "15273397373483412251"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "customerSlug": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    }
  },
  "variables": {
    "vnetName": "[format('vnet-azurechat-{0}', parameters('customerSlug'))]",
    "integrationSubnetName": "integration",
    "privateLinkSubnetName": "privatelink"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.0.0.0/24"
          ]
        },
        "subnets": [
          {
            "name": "[variables('integrationSubnetName')]",
            "properties": {
              "addressPrefix": "10.0.0.0/26",
              "delegations": [
                {
                  "name": "appServiceDelegation",
                  "properties": {
                    "serviceName": "Microsoft.Web/serverFarms"
                  }
                }
              ]
            }
          },
          {
            "name": "[variables('privateLinkSubnetName')]",
            "properties": {
              "addressPrefix": "10.0.0.64/26",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ]
      }
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
    },
    "integrationSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), variables('integrationSubnetName'))]"
    },
    "privateLinkSubnetId": {
      "type": "string",
      "value": "[format('{0}/subnets/{1}', resourceId('Microsoft.Network/virtualNetworks', variables('vnetName')), variables('privateLinkSubnetName'))]"
    }
  }
}