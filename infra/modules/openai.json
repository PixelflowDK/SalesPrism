{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "4485051071132599490"
    }
  },
  "parameters": {
    "customerSlug": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "aiModelTier": {
      "type": "string",
      "allowedValues": [
        "standard",
        "professional",
        "enterprise"
      ]
    },
    "aiModelSkuName": {
      "type": "string",
      "defaultValue": "DataZoneStandard",
      "allowedValues": [
        "DataZoneStandard"
      ],
      "metadata": {
        "description": "Azure OpenAI deployment SKU — GDPR R2: DataZoneStandard only, never GlobalStandard."
      }
    },
    "chatModelNameOverride": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Override the tier-mapped chat model name. Leave empty to use the ADR-001 tier default."
      }
    },
    "chatModelVersionOverride": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Override the tier-mapped chat model version. Leave empty to use the ADR-001 tier default."
      }
    },
    "chatModelCapacityOverride": {
      "type": "int",
      "defaultValue": 0,
      "metadata": {
        "description": "Override the tier-mapped chat model capacity (1K TPM units). Leave 0 to use the ADR-001 tier default."
      }
    },
    "embeddingModelName": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Embedding model name — GA per ADR-001 (text-embedding-3-small until the -large quota grant lands)."
      }
    },
    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Embedding model version."
      }
    },
    "embeddingModelCapacity": {
      "type": "int",
      "defaultValue": 30,
      "metadata": {
        "description": "Embedding model deployment capacity (1K TPM units)."
      }
    }
  },
  "variables": {
    "accountName": "[format('oai-azurechat-{0}', parameters('customerSlug'))]",
    "tierModel": "[if(equals(parameters('aiModelTier'), 'standard'), createObject('name', 'gpt-5.4-mini', 'version', '2026-03-17', 'capacity', 30), if(equals(parameters('aiModelTier'), 'professional'), createObject('name', 'gpt-5.4', 'version', '2026-03-05', 'capacity', 20), createObject('name', 'gpt-5.5', 'version', '2026-04-24', 'capacity', 10)))]",
    "selectedChatModel": {
      "name": "[if(empty(parameters('chatModelNameOverride')), variables('tierModel').name, parameters('chatModelNameOverride'))]",
      "version": "[if(empty(parameters('chatModelVersionOverride')), variables('tierModel').version, parameters('chatModelVersionOverride'))]",
      "capacity": "[if(equals(parameters('chatModelCapacityOverride'), 0), variables('tierModel').capacity, parameters('chatModelCapacityOverride'))]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-04-01-preview",
      "name": "[variables('accountName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "publicNetworkAccess": "Disabled",
        "customSubDomainName": "[variables('accountName')]",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), variables('selectedChatModel').name)]",
      "sku": {
        "name": "[parameters('aiModelSkuName')]",
        "capacity": "[variables('selectedChatModel').capacity]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[variables('selectedChatModel').name]",
          "version": "[variables('selectedChatModel').version]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-04-01-preview",
      "name": "[format('{0}/{1}', variables('accountName'), parameters('embeddingModelName'))]",
      "sku": {
        "name": "[parameters('aiModelSkuName')]",
        "capacity": "[parameters('embeddingModelCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('embeddingModelName')]",
          "version": "[parameters('embeddingModelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/deployments', variables('accountName'), variables('selectedChatModel').name)]"
      ]
    }
  ],
  "outputs": {
    "openAiId": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', variables('accountName'))]"
    },
    "openAiName": {
      "type": "string",
      "value": "[variables('accountName')]"
    },
    "openAiEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('accountName')), '2024-04-01-preview').endpoint]"
    },
    "chatModelDeploymentName": {
      "type": "string",
      "value": "[variables('selectedChatModel').name]"
    },
    "embeddingModelDeploymentName": {
      "type": "string",
      "value": "[parameters('embeddingModelName')]"
    },
    "chatModelCapacity": {
      "type": "int",
      "value": "[variables('selectedChatModel').capacity]"
    }
  }
}