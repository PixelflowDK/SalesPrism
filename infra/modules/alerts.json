{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "11647747235245843726"
    }
  },
  "parameters": {
    "customerSlug": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "tags": {
      "type": "object"
    },
    "alertEmailAddress": {
      "type": "string",
      "defaultValue": "kontakt@pixelflow.dk",
      "metadata": {
        "description": "Action group email receiver. Default matches CLAUDE.md/task default."
      }
    },
    "appServiceHostname": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.Web/sites resource id (app-azurechat-{slug}) — used for the availability webtest target URL."
      }
    },
    "appServicePlanId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.Web/serverfarms resource id (plan-azurechat-{slug}) — CPU alert scope."
      }
    },
    "appInsightsId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.Insights/components resource id (appi-azurechat-{slug}) — availability + HTTP 5xx log-query alert scope."
      }
    },
    "openAiId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.CognitiveServices/accounts resource id (oai-azurechat-{slug})."
      }
    },
    "chatDeploymentName": {
      "type": "string"
    },
    "chatModelCapacity": {
      "type": "int",
      "metadata": {
        "description": "Chat model deployment capacity, 1K TPM units (modules/openai.bicep output)."
      }
    },
    "embeddingDeploymentName": {
      "type": "string"
    },
    "embeddingModelCapacity": {
      "type": "int",
      "metadata": {
        "description": "Embedding model deployment capacity, 1K TPM units."
      }
    },
    "cosmosId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.DocumentDB/databaseAccounts resource id (cosmos-azurechat-{slug})."
      }
    },
    "aiSearchId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft.Search/searchServices resource id (srch-azurechat-{slug})."
      }
    },
    "monthlyBudgetAmount": {
      "type": "int",
      "defaultValue": 1000,
      "metadata": {
        "description": "SAD §17 monthly Azure cost estimate for this customer tier, in the subscription billing currency — used as the Microsoft.Consumption/budgets baseline. NOT a literal daily figure; see the budget resource comment below for why \"150% of daily baseline\" cannot be expressed natively as a per-resource-group ARM resource."
      }
    },
    "budgetStartDate": {
      "type": "string",
      "defaultValue": "[utcNow('yyyy-MM-01')]",
      "metadata": {
        "description": "First day of the current month (yyyy-MM-01) — Microsoft.Consumption/budgets requires an explicit timePeriod.startDate and rejects inline utcNow() outside a parameter default."
      }
    }
  },
  "variables": {
    "actionGroupName": "[format('ag-azurechat-{0}', parameters('customerSlug'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Insights/actionGroups",
      "apiVersion": "2023-01-01",
      "name": "[variables('actionGroupName')]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "groupShortName": "SalesPrism",
        "enabled": true,
        "emailReceivers": [
          {
            "name": "operator",
            "emailAddress": "[parameters('alertEmailAddress')]",
            "useCommonAlertSchema": true
          }
        ]
      }
    },
    {
      "type": "Microsoft.Insights/webtests",
      "apiVersion": "2022-06-15",
      "name": "[format('webtest-availability-{0}', parameters('customerSlug'))]",
      "location": "[parameters('location')]",
      "tags": "[union(parameters('tags'), createObject(format('hidden-link:{0}', parameters('appInsightsId')), 'Resource'))]",
      "properties": {
        "SyntheticMonitorId": "[format('webtest-availability-{0}', parameters('customerSlug'))]",
        "Name": "[format('webtest-availability-{0}', parameters('customerSlug'))]",
        "Enabled": true,
        "Frequency": 300,
        "Timeout": 30,
        "Kind": "ping",
        "RetryEnabled": true,
        "Locations": [
          {
            "Id": "emea-nl-ams-azr"
          },
          {
            "Id": "emea-gb-db3-azr"
          }
        ],
        "Configuration": {
          "WebTest": "[format('<WebTest Name=\"webtest-availability-{0}\" Enabled=\"True\" CssProjectStructure=\"\" CssIteration=\"\" Timeout=\"30\" WorkItemIds=\"\" xmlns=\"http://microsoft.com/schemas/VisualStudio/TeamTest/2010\" Description=\"\" CredentialUserName=\"\" CredentialPassword=\"\" PreAuthenticate=\"True\" Proxy=\"default\" StopOnError=\"False\" RecordedResultFile=\"\" ResultsLocale=\"\"><Items><Request Method=\"GET\" Version=\"1.1\" Url=\"https://{1}/\" ThinkTime=\"0\" Timeout=\"30\" ParseDependentRequests=\"False\" FollowRedirects=\"True\" RecordResult=\"True\" Cache=\"False\" ResponseTimeGoal=\"0\" Encoding=\"utf-8\" ExpectedHttpStatusCode=\"200\" ExpectedResponseUrl=\"\" ReportingName=\"\" IgnoreHttpStatusCode=\"False\" /></Items></WebTest>', parameters('customerSlug'), parameters('appServiceHostname'))]"
        }
      }
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-availability-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "SAD §31.2 — App Service availability < 99% over 5 minutes (via Application Insights availability test).",
        "severity": 1,
        "enabled": true,
        "scopes": [
          "[parameters('appInsightsId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "targetResourceType": "Microsoft.Insights/components",
        "targetResourceRegion": "[parameters('location')]",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "AvailabilityBelow99",
              "metricNamespace": "Microsoft.Insights/components",
              "metricName": "availabilityResults/availabilityPercentage",
              "operator": "LessThan",
              "threshold": 99,
              "timeAggregation": "Average"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]",
        "[resourceId('Microsoft.Insights/webtests', format('webtest-availability-{0}', parameters('customerSlug')))]"
      ]
    },
    {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2022-06-15",
      "name": "[format('alert-http5xx-{0}', parameters('customerSlug'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "SAD §31.2 — HTTP 5xx rate > 5% over 5 minutes. Requires SR-010 telemetry (Application Insights requests table) to be flowing.",
        "severity": 1,
        "enabled": true,
        "scopes": [
          "[parameters('appInsightsId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "allOf": [
            {
              "query": "requests | summarize total = count(), errors = countif(toint(resultCode) >= 500) | extend pct = iff(total == 0, 0.0, 100.0 * todouble(errors) / todouble(total)) | project pct",
              "timeAggregation": "Average",
              "metricMeasureColumn": "pct",
              "operator": "GreaterThan",
              "threshold": 5,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        },
        "actions": {
          "actionGroups": [
            "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-openai-quota-chat-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('SAD §31.2 — Azure OpenAI chat deployment ({0}) token usage > 80% of provisioned TPM over 5 minutes.', parameters('chatDeploymentName'))]",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('openAiId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "ChatTokenQuota80Pct",
              "metricNamespace": "Microsoft.CognitiveServices/accounts",
              "metricName": "TokenTransaction",
              "dimensions": [
                {
                  "name": "ModelDeploymentName",
                  "operator": "Include",
                  "values": [
                    "[parameters('chatDeploymentName')]"
                  ]
                }
              ],
              "operator": "GreaterThan",
              "threshold": "[mul(parameters('chatModelCapacity'), 4000)]",
              "timeAggregation": "Total"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-openai-quota-embedding-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "[format('SAD §31.2 — Azure OpenAI embedding deployment ({0}) token usage > 80% of provisioned TPM over 5 minutes.', parameters('embeddingDeploymentName'))]",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('openAiId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "EmbeddingTokenQuota80Pct",
              "metricNamespace": "Microsoft.CognitiveServices/accounts",
              "metricName": "TokenTransaction",
              "dimensions": [
                {
                  "name": "ModelDeploymentName",
                  "operator": "Include",
                  "values": [
                    "[parameters('embeddingDeploymentName')]"
                  ]
                }
              ],
              "operator": "GreaterThan",
              "threshold": "[mul(parameters('embeddingModelCapacity'), 4000)]",
              "timeAggregation": "Total"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-cosmos-throttling-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "SAD §31.2 — Cosmos DB throttling: > 10 requests with StatusCode 429 (TooManyRequests) over 5 minutes. Interpretation of \"RU/s\" — see module comment.",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('cosmosId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "CosmosThrottledRequests",
              "metricNamespace": "Microsoft.DocumentDB/databaseAccounts",
              "metricName": "TotalRequests",
              "dimensions": [
                {
                  "name": "StatusCode",
                  "operator": "Include",
                  "values": [
                    "429"
                  ]
                }
              ],
              "operator": "GreaterThan",
              "threshold": 10,
              "timeAggregation": "Count"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-aisearch-throttling-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "SAD §31.2 — AI Search throttled (503) query percentage > 5% over 5 minutes.",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('aiSearchId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT5M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "ThrottledSearchQueriesAbove5Pct",
              "metricNamespace": "Microsoft.Search/searchServices",
              "metricName": "ThrottledSearchQueriesPercentage",
              "operator": "GreaterThan",
              "threshold": 5,
              "timeAggregation": "Average"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Insights/metricAlerts",
      "apiVersion": "2018-03-01",
      "name": "[format('alert-cpu-{0}', parameters('customerSlug'))]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "properties": {
        "description": "SAD §31.2 — App Service Plan CPU > 85% over 10 minutes.",
        "severity": 2,
        "enabled": true,
        "scopes": [
          "[parameters('appServicePlanId')]"
        ],
        "evaluationFrequency": "PT5M",
        "windowSize": "PT10M",
        "criteria": {
          "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria",
          "allOf": [
            {
              "criterionType": "StaticThresholdCriterion",
              "name": "CpuAbove85Pct",
              "metricNamespace": "Microsoft.Web/serverfarms",
              "metricName": "CpuPercentage",
              "operator": "GreaterThan",
              "threshold": 85,
              "timeAggregation": "Average"
            }
          ]
        },
        "actions": [
          {
            "actionGroupId": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
      ]
    },
    {
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2023-05-01",
      "name": "[format('budget-azurechat-{0}', parameters('customerSlug'))]",
      "properties": {
        "category": "Cost",
        "amount": "[parameters('monthlyBudgetAmount')]",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]"
        },
        "notifications": {
          "actual_GreaterThan_150Pct": {
            "enabled": true,
            "operator": "GreaterThan",
            "threshold": 150,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('alertEmailAddress')]"
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "actionGroupId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/actionGroups', variables('actionGroupName'))]"
    },
    "availabilityWebTestId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/webtests', format('webtest-availability-{0}', parameters('customerSlug')))]"
    }
  }
}