# NOTES:
# - You will find most of these variables in the `/.azure/<env>/.env` file.
# - Do not use double-quotes and do not delete any of the variables.
# - Make sure that NEXTAUTH_URL=http://localhost:3000 has no comments in the same line.

# PÅKRÆVET — managed identity (passwordless authentication for all Azure services)
# This builds a DefaultAzureCredential from your local logged in user (az login)
USE_MANAGED_IDENTITIES=true

# Update your Azure OpenAI details
# AZURE_OPENAI_API_INSTANCE_NAME should be just the name of the azure openai resource, not the full url.
# AZURE_OPENAI_CHAT_DEPLOYMENT / AZURE_OPENAI_EMBEDDING_DEPLOYMENT are deployment names, which in
# infra/modules/openai.bicep are the model names themselves (see ADR-001 tier table).
# AZURE_OPENAI_API_VERSION should be a supported version: https://learn.microsoft.com/en-us/azure/ai-services/openai/reference

# FORBUDT — ingen API-nøgle-variabel for Azure OpenAI, Cosmos DB, AI Search eller
# Storage må nogensinde sættes, hverken her eller i produktion (managed identity bruges altid i stedet)

AZURE_OPENAI_API_INSTANCE_NAME=ABC-aillm-XYZ
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ADR-003 — admin authorization by the verified Entra `oid` claim (object id),
# comma-separated, never an email/UPN. For local dev with the `localdev`
# CredentialsProvider, the synthesized dev oid is `hashValue("<username>@localhost")`
# (see auth-api.ts) — log in once and check the server console's
# "DEV USER LOGGED IN" line for the exact value to add here.
ADMIN_OBJECT_IDS=00000000-0000-0000-0000-000000000000

# Identity provider is optional if you are running in development mode locally (npm run dev)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Update your production URL in NEXTAUTH_URL
NEXTAUTH_SECRET=REPLACE-WITH-STRONG-RANDOM-SECRET
# in production, this should be your production URL e.g. https://salesprism.azurewebsites.net
NEXTAUTH_URL=http://localhost:3000

# Update your Cosmos Environment details here
AZURE_COSMOSDB_URI=https://<cosmoresourcename>.documents.azure.com:443/

# Update your Cosmos variables if you want to overwrite the default values
AZURE_COSMOSDB_DB_NAME=chat
AZURE_COSMOSDB_CONTAINER_NAME=history
AZURE_COSMOSDB_CONFIG_CONTAINER_NAME=config

# Tenant resolution fallback (src/features/theme/tenant-resolver.ts) — used
# whenever the Host header isn't a recognized `{slug}-sales360.pixelflow.dk`
# subdomain (local dev, *.azurewebsites.net staging slots).
TENANT_SLUG=val1
# Seeded on first boot for this tenant if no TenantTheme document exists yet
# (src/features/theme/tenant-theme.ts). One of: smb | professional | enterprise
PLATFORM_TIER=smb

# Azure AI Search is used for chat over your data
AZURE_SEARCH_NAME=ABCsearchXYZ
AZURE_SEARCH_INDEX_NAME=azure-chat

# Azure AI Document Intelligence to extract content from your data
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://NAME.cognitiveservices.azure.com/

# max upload document size in bytes
MAX_UPLOAD_DOCUMENT_SIZE=20000000

# Azure Speech to Text to convert audio to text
# NOTE: Speech does not support managed identity yet, so you need to populate these for speech to work locally
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=

# Azure Storage account to store files
AZURE_STORAGE_ACCOUNT_NAME=ABCstoXYZ

# Azure Key Vault to store secrets
AZURE_KEY_VAULT_NAME=ABC-kv-XYZ

# optional - endpoint suffix overrides - typically used for Azure Government Clouds, China Clouds, etc. Only use if required.
# AZURE_SEARCH_ENDPOINT_SUFFIX=
# AZURE_STORAGE_ENDPOINT_SUFFIX=
# AZURE_KEY_VAULT_ENDPOINT_SUFFIX=

# to enable debug logging, set DEBUG=true
DEBUG=false
